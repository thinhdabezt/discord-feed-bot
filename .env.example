# Discord
DISCORD_TOKEN=replace_me
DISCORD_CHANNEL_ID=123456789012345678

# PostgreSQL on another machine.
# For a local LAN DB, replace 192.168.1.20 with the host's LAN IP.
DATABASE_URL=postgresql+asyncpg://bot_user:change_me@192.168.1.20:5432/discord_feed_bot

# Polling
POLL_INTERVAL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=20
MAX_ITEMS_PER_SOURCE=10
USER_AGENT=DiscordFeedBot/0.1 (+https://example.invalid/bot)

# Optional: set true only after you have created tables with migrations.
# This starter uses create_all for initial development only.
DB_CREATE_TABLES=true
